# Copy to .env (loaded by run.ps1 / run.sh) or set in your shell.

# Inference engine:
#   comfy     -> drive a running ComfyUI (light; uses your quantized + turbo LoRA setup)
#   diffusers -> load MiniMax-H3 locally with diffusers (full bf16, heavy)
H3_BACKEND=comfy

# --- ComfyUI backend (H3_BACKEND=comfy) ---
COMFY_URL=http://127.0.0.1:8188
# H3_WORKFLOW_DIR=./workflows      # holds <mode>.json + mapping.json

# --- diffusers backend (H3_BACKEND=diffusers) ---
# Real generation by default (0). Set 1 only to smoke-test the UI with no GPU.
H3_MOCK=0
H3_MODEL_ID=MiniMaxAI/MiniMax-H3
#   auto     -> single 80GB accelerator + auto CPU offload
#   consumer -> int8 quant + group offload (24-32GB VRAM, ~75GB host RAM)
H3_DEVICE_MODE=auto
H3_DEVICE=cuda
H3_MEMORY_RESERVE_MARGIN=12GB

# Where files go (optional).
# H3_OUTPUT_DIR=./outputs
# H3_UPLOAD_DIR=./uploads

# Extra CORS origins, comma separated (the Vite dev server is allowed by default).
# H3_CORS_ORIGINS=http://localhost:5173
